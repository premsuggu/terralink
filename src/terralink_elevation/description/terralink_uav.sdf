<?xml version='1.0'?>
<sdf version='1.7'>
  <model name='terralink_uav'>
    <static>1</static>
    <link name='uav_base_link'>
      <inertial>
        <pose>0 0 0.005 0 0 0</pose>
        <mass>50</mass>
        <inertia>
          <ixx>0.375417</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.375417</iyy>
          <iyz>0</iyz>
          <izz>0.75</izz>
        </inertia>
      </inertial>
      <!-- Depth camera sensor for elevation mapping -->
      <sensor name='depth_camera' type='depth'>
        <always_on>1</always_on>
        <visualize>0</visualize>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.25</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1000</width>
            <height>1000</height>
          </image>
          <clip>
            <near>0.5</near>
            <far>30.0</far>
          </clip>
        </camera>
        <plugin name='depth_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>/terralink_uav</namespace>
            <remapping>~/image_raw:=/depth/image_raw</remapping>
            <remapping>~/depth:=/depth/image_raw</remapping>
            <remapping>~/points:=/depth/points</remapping>
          </ros>
          <frame_name>depth_camera_optical</frame_name>
        </plugin>
        <!-- Camera pointing DOWN: pose x=0, y=0, z=5, roll=3.14159, pitch=1.57079, yaw=3.14159 -->
        <pose>0 0 5 3.14159 1.57079 3.14159</pose>
      </sensor>
      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
      <pose>0 0 0 0 0 0</pose>
      <visual name='chassis_visual'>
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.01 0.01</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/White</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
          <shader type='pixel'/>
          <emissive>0 0 0 1</emissive>
        </material>
        <transparency>0</transparency>
        <cast_shadows>1</cast_shadows>
      </visual>
      <visual name='camera_link_visual'>
        <pose>0 0 5 3.14159 1.57079 3.14159</pose>
        <geometry>
          <box>
            <size>0.05 0.03 0.03</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Red</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
          <shader type='pixel'/>
          <emissive>0 0 0 1</emissive>
        </material>
        <transparency>0</transparency>
        <cast_shadows>1</cast_shadows>
      </visual>
      <collision name='chassis_collision'>
        <laser_retro>0</laser_retro>
        <max_contacts>10</max_contacts>
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.1 0.01</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <allow_auto_disable>1</allow_auto_disable>
  </model>
</sdf>