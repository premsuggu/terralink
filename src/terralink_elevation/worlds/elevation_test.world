<sdf version='1.7'>
  <world name='default'>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <!-- Ground plane - visual only, no collision (hills provide collision) -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Large hill at origin (0, 0) height 2m - CENTER of camera view -->
    <model name='hill_center'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>8 8 2.0</size>
            </box>
          </geometry>
          <pose>0 0 1.0 0 0 0</pose>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>8 8 2.0</size>
            </box>
          </geometry>
          <pose>0 0 1.0 0 0 0</pose>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>
    
    <!-- Elevated platform at (5, 0) height 1.5m -->
    <model name='hill_east'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>4 4 1.5</size>
            </box>
          </geometry>
          <pose>0 0 0.75 0 0 0</pose>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>4 4 1.5</size>
            </box>
          </geometry>
          <pose>0 0 0.75 0 0 0</pose>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Brown</name>
            </script>
          </material>
        </visual>
      </link>
      <pose>5 0 0 0 0 0</pose>
    </model>
    
    <!-- Elevated platform at (-5, 0) height 1.0m -->
    <model name='hill_west'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>3 3 1.0</size>
            </box>
          </geometry>
          <pose>0 0 0.5 0 0 0</pose>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>3 3 1.0</size>
            </box>
          </geometry>
          <pose>0 0 0.5 0 0 0</pose>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Brown</name>
            </script>
          </material>
        </visual>
      </link>
      <pose>-5 0 0 0 0 0</pose>
    </model>
    
    <!-- Wall at (0, 5) height 2m -->
    <model name='wall_north'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.5 6 2.0</size>
            </box>
          </geometry>
          <pose>0 0 1.0 0 0 0</pose>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.5 6 2.0</size>
            </box>
          </geometry>
          <pose>0 0 1.0 0 0 0</pose>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <pose>0 5 0 0 0 0</pose>
    </model>
    
    <!-- Steep ramp at (3, -3) -->
    <model name='ramp1'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>4 2 1.0</size>
            </box>
          </geometry>
          <pose>0 0 0.5 0 0.3 0</pose>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>4 2 1.0</size>
            </box>
          </geometry>
          <pose>0 0 0.5 0 0.3 0</pose>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
      <pose>3 -3 0 0 0 0</pose>
    </model>
    
    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
  </world>
</sdf>