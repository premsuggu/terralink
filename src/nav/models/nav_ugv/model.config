<?xml version="1.0"?>
<model>
  <name>Nav UGV</name>
  <version>2.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>TerraLink nav</name>
    <email>software.guild@smail.iitm.ac.in</email>
  </author>

  <description>
    A Clearpath Jackal-class 4-wheel skid-steer ground rover (0.51 x 0.43 x 0.25 m, 16.5 kg): meshes, dimensions, mass and
    inertia from the official jackal_description (BSD, see meshes/LICENSE_clearpath_jackal), written as native Ignition SDF.
    Sensors: top-deck planar lidar (360 rays, 0.3-12 m), front depth camera tilted down 0.6 rad (feeds the shared
    /elevation_map), and a video camera. The DiffDrive / OdometryPublisher plugins are attached at include time in the worlds
    (effective wheel_separation 0.49 m for the skid-steer slip). See docs/work-docs/nav/step10_jackal_ugv_model.md.
  </description>
</model>
