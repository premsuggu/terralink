<?xml version="1.0"?>
<!-- nav_ugv: a Clearpath Jackal-class 4-wheel skid-steer rover (2026-10-26; replaced the old 0.3 m box rover).

     WHERE THE NUMBERS COME FROM: the official jackal_description (github.com/jackal/jackal, BSD licence, see
     meshes/LICENSE_clearpath_jackal): meshes, wheel radius 0.098, track 0.37559, wheelbase 0.262, chassis mass
     16.523 kg and its inertia, wheel mass 0.477 kg. The robot is ~0.51 m long, 0.43 m wide (outside of the wheels),
     0.25 m tall.

     WHAT STAYS THE SAME FOR THE REST OF THE STACK (nothing else in the project had to change for these):
       * model name `nav_ugv`, frame `base_link` and the wheel joint names `left_wheel_joint` / `right_wheel_joint`
         (the two FRONT wheels; the rear ones are `rear_left_wheel_joint` / `rear_right_wheel_joint` and the world's
         DiffDrive plugin lists both per side)
       * `base_link` sits 0.125 m above the ground (the old chassis centre), so spawn heights and the elevation
         bookkeeping (nav/floor_map_node.py: floor = lidar z - lidar height above base_link) are unchanged
       * sensors: topics `nav_ugv/scan` (360 rays, 0.3-12 m, 10 Hz), `nav_ugv/front_camera` (rgbd, tilted down 0.6 rad,
         ~0.15 m above the floor like before) and `nav_ugv/video_camera`
     WHAT CHANGED (and had to be followed by launch files / worlds / floor_map_node):
       * the lidar moved UP onto the top deck, (0.10, 0, 0.165) in base_link = 0.29 m above ground (the body is 0.25 m
         tall: at the old 0.095 the beam would have hit the robot's own body)
       * X = 0.15 m above ground
       * the physical size: 0.51 x 0.43 m instead of ~0.3 x 0.44; DiffDrive wheel_radius 0.098, effective wheel_separation 0.49 (the real track is 0.3756; see the wheel note)

     No <plugin> here: the DiffDrive / OdometryPublisher plugins are attached at include time in the worlds, as for
     iris_quad (the model stays simulator-plugin-agnostic).

     Pose conventions. WATCH OUT: the poses of the base_link LINK and of the wheel / camera LINKS are relative to the MODEL origin
       (= the ground, so z is the height above ground), while the visuals, collision and sensors INSIDE base_link are relative
       to base_link (ground is at z = -0.125 there). Static TFs in the launch files are relative to base_link:
       * Jackal's own `base_link` is the axle-ish frame 0.0635 m above ground (wheel centre +0.0345 -> ground at -0.0635),
         so Jackal's z values map to ours by  z_ours = z_jackal - 0.0615.
       * A wheel link is rolled by -90 deg: its local Z axis (the joint axis) then points along +Y, so a positive joint
         velocity rolls the robot forward. The wheel mesh's own axis is Z, so it needs no extra rotation.
       * The chassis mesh was authored as (y-up) and needs rpy (pi/2, 0, pi/2); Jackal's URDF does exactly that. -->
<sdf version="1.6">
  <model name="nav_ugv">
    <link name="base_link">
      <pose>0 0 0.125 0 0 0</pose>
      <inertial>
        <!-- centre of mass and inertia of the chassis WITHOUT wheels, from jackal.urdf.xacro (com z relative to Jackal's
             base_link 0.067 -> 0.0055 in ours) -->
        <pose>0.012 0.002 0.0055 0 0 0</pose>
        <mass>16.523</mass>
        <inertia>
          <ixx>0.3136</ixx><ixy>-0.0008</ixy><ixz>0.0164</ixz>
          <iyy>0.3922</iyy><iyz>-0.0009</iyz>
          <izz>0.4485</izz>
        </inertia>
      </inertial>

      <visual name="chassis_visual">
        <pose>0 0 -0.127 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>model://nav_ugv/meshes/jackal-base.stl</uri></mesh></geometry>
        <material>
          <ambient>0.12 0.12 0.13 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse><specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <visual name="front_fender_visual">
        <pose>0 0 -0.0615 0 0 0</pose>
        <geometry><mesh><uri>model://nav_ugv/meshes/jackal-fender.stl</uri></mesh></geometry>
        <material>
          <ambient>0.9 0.7 0.0 1</ambient><diffuse>1.0 0.8 0.0 1</diffuse><specular>0.4 0.4 0.2 1</specular>
        </material>
      </visual>
      <visual name="rear_fender_visual">
        <pose>0 0 -0.0615 0 0 3.14159</pose>
        <geometry><mesh><uri>model://nav_ugv/meshes/jackal-fender.stl</uri></mesh></geometry>
        <material>
          <ambient>0.9 0.7 0.0 1</ambient><diffuse>1.0 0.8 0.0 1</diffuse><specular>0.4 0.4 0.2 1</specular>
        </material>
      </visual>

      <!-- The URDF's own collision shape: a 0.42 x 0.31 x 0.184 box whose bottom is 0.0635 m above the ground
           (ground clearance), centre at z = -0.0615 + 0.092 = 0.0305. -->
      <collision name="chassis_collision">
        <pose>0 0 0.0305 0 0 0</pose>
        <geometry><box><size>0.42 0.31 0.184</size></box></geometry>
      </collision>

      <!-- Top-deck lidar (a visible puck): 0.29 m above the ground, clear of the body. Same scan as before. -->
      <visual name="lidar_visual">
        <pose>0.1 0 0.165 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.1 0 0.165 0 0 0</pose>
        <topic>nav_ugv/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- Four driven wheels. Collision is a SPHERE of the wheel's radius (a cylinder's edge gives line-contact friction
         and rolling artefacts; the old model chose the same). A skid-steer robot turns by SLIPPING its wheels
         sideways. Measured here (spin 1 rad/s / arc 0.4 m/s 0.5 rad/s, test world in the step10 doc): with mu = mu2 = 1.0 the
         robot turns at 77 % of the commanded rate, so the worlds give DiffDrive an EFFECTIVE wheel_separation of 0.49 m
         (0.3756 / 0.77) and the turn then matches the command (167 of 172 deg, 118 of 115 deg). -->
    <link name="left_wheel">
      <pose>0.131 0.1878 0.098 -1.5708 0 0</pose>
      <inertial><mass>0.477</mass><inertia><ixx>0.0013</ixx><iyy>0.0013</iyy><izz>0.0024</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><geometry><mesh><uri>model://nav_ugv/meshes/jackal-wheel.stl</uri></mesh></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <collision name="collision"><geometry><sphere><radius>0.098</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    </link>
    <link name="rear_left_wheel">
      <pose>-0.131 0.1878 0.098 -1.5708 0 0</pose>
      <inertial><mass>0.477</mass><inertia><ixx>0.0013</ixx><iyy>0.0013</iyy><izz>0.0024</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><geometry><mesh><uri>model://nav_ugv/meshes/jackal-wheel.stl</uri></mesh></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <collision name="collision"><geometry><sphere><radius>0.098</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    </link>
    <link name="right_wheel">
      <pose>0.131 -0.1878 0.098 -1.5708 0 0</pose>
      <inertial><mass>0.477</mass><inertia><ixx>0.0013</ixx><iyy>0.0013</iyy><izz>0.0024</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><geometry><mesh><uri>model://nav_ugv/meshes/jackal-wheel.stl</uri></mesh></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <collision name="collision"><geometry><sphere><radius>0.098</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    </link>
    <link name="rear_right_wheel">
      <pose>-0.131 -0.1878 0.098 -1.5708 0 0</pose>
      <inertial><mass>0.477</mass><inertia><ixx>0.0013</ixx><iyy>0.0013</iyy><izz>0.0024</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><geometry><mesh><uri>model://nav_ugv/meshes/jackal-wheel.stl</uri></mesh></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <collision name="collision"><geometry><sphere><radius>0.098</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    </link>

    <!-- "very large but finite" limits: SDF requires <limit> on a revolute joint; a wheel has no real limit. -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>

    <!-- Front depth camera (step05): sees the floor 0.1-0.8 m ahead through a tilt of 0.6 rad; it now sits on the front
         face of the body, 0.15 m above the ground. It feeds the shared /elevation_map (emap secondary points). -->
    <link name="front_camera_link">
      <pose>0.27 0 0.155 0 0.6 0</pose>
      <inertial><mass>0.02</mass><inertia><ixx>0.000005</ixx><iyy>0.000005</iyy><izz>0.000005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="front_camera_visual">
        <geometry><box><size>0.03 0.05 0.03</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <sensor name="front_camera" type="rgbd_camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>nav_ugv/front_camera</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>320</width><height>240</height></image>
          <clip><near>0.1</near><far>8.0</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent><child>front_camera_link</child>
    </joint>

    <!-- Camera for the recorded videos only (not used for sensing): above the top deck, mild downward tilt. -->
    <link name="video_camera_link">
      <pose>0.2 0 0.30 0 0.15 0</pose>
      <inertial><mass>0.02</mass><inertia><ixx>0.000005</ixx><iyy>0.000005</iyy><izz>0.000005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="video_camera_visual">
        <geometry><box><size>0.03 0.05 0.03</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <sensor name="video_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>nav_ugv/video_camera</topic>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image><width>320</width><height>240</height></image>
          <clip><near>0.1</near><far>15.0</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="video_camera_joint" type="fixed">
      <parent>base_link</parent><child>video_camera_link</child>
    </joint>
  </model>
</sdf>
