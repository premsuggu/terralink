<?xml version="1.0"?>
<!-- See model.config for the full design rationale (adapted from d3's
     robot_core.xacro + lidar.xacro, expressed as native Ignition SDF).
     No <plugin> here - the DiffDrive actuation plugin is attached at
     include time in worlds/room_maze.world, exactly like models/iris_quad's
     motor plugins are (see that model's own model.config for the same
     reasoning: keeps the model itself simulator-plugin-agnostic, only the
     world that actually uses it decides how it's driven). -->
<sdf version="1.6">
  <model name="nav_ugv">
    <link name="base_link">
      <!-- Chassis center sits at wheel_radius + chassis_z/2 = 0.05 + 0.075
           = 0.125m above the ground - just tall enough that the box's
           bottom face clears the wheels' contact patch. -->
      <pose>0 0 0.125 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0138</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0138</iyy>
          <iyz>0</iyz>
          <izz>0.0225</izz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.3 0.3 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.3 0.3 0.15</size>
          </box>
        </geometry>
      </collision>

      <!-- Planar lidar, forward-and-up of chassis center - same role as
           d3's laser_frame (lidar.xacro), now expressed as a native
           `gpu_lidar` sensor rather than a separate link + Classic ray
           sensor plugin. 360 samples over a full circle, 0.3-12m range -
           matches d3's own scan parameters exactly (only the plugin
           mechanism changed, not the sensor's own specs). -->
      <visual name="lidar_visual">
        <pose>0.1 0 0.095 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.6 0 0 1</ambient>
          <diffuse>0.6 0 0 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.1 0 0.095 0 0 0</pose>
        <topic>nav_ugv/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- Driven wheels: cylinder visual (looks like a wheel), sphere
         collision (avoids a cylinder edge's line-contact friction/rolling
         artifacts - the same collision-shape choice d3's own wheel links
         made). Each wheel link's own <pose> already bakes in both its
         position AND the 90-degree roll that makes its local Z axis (the
         joint's rotation axis, below) point along the model's Y axis - the
         same "rotate the link, keep the joint axis simple" pattern the
         installed Ignition example vehicles use (see
         /usr/share/ignition/ignition-gazebo6/worlds/log_record_keyboard.sdf). -->
    <link name="left_wheel">
      <pose>0 0.2 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.00013</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00013</iyy>
          <iyz>0</iyz>
          <izz>0.00025</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 1 1</ambient>
          <diffuse>0.2 0.2 1 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
      </collision>
    </link>

    <link name="right_wheel">
      <pose>0 -0.2 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.00013</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00013</iyy>
          <iyz>0</iyz>
          <izz>0.00025</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 1 1</ambient>
          <diffuse>0.2 0.2 1 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
      </collision>
    </link>

    <!-- Passive casters: low-friction spheres (see the <surface> block
         below), same role as d3's caster_wheel link - a third (and fourth,
         see front_caster_wheel below) contact point that lets the two
         driven wheels alone determine heading (pure differential drive),
         rather than fighting a rigidly-mounted wheel's own rolling
         constraint. -->
    <link name="caster_wheel">
      <pose>-0.13 0 0.03 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000036</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000036</iyy>
          <iyz>0</iyz>
          <izz>0.000036</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.001</mu>
              <mu2>0.001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- REAL BUG FOUND LIVE (GUI-mode run, 2026-09-24): with only a REAR
         caster, the chassis had NO ground-contact support anywhere forward
         of the drive-wheel axle (x=0) - the whole front half of the 0.3m
         chassis (x=0 to x=0.15) was structurally unsupported, held up only
         by the wheels' own rolling resistance. That was survivable at the
         original TurtleBot3-Burger-style speed (max_vel_x=0.26,
         acc_lim_x/decel_lim_x=2.5 - see nav2_params.yaml's own comment for
         why those were later raised), but nav2_params.yaml's speed increase
         (0.6 m/s, 3.5 m/s^2 accel/decel) was never paired with a matching
         chassis change - a harder stop at the new speed had real momentum
         to arrest with nothing in front to catch it. Confirmed live via
         Ignition's own physics ground truth (`/world/tunnel_test/
         dynamic_pose/info`, NOT `/ugv/odom` - see this project's own
         "wheel odometry lied" retraction in step06_hybrid_3d_voxel_
         navigation.md for why that distinction matters): the chassis
         pitched to ~19.5 degrees and stopped dead in room A, nowhere near
         the tunnel, while a rear/lifted drive wheel kept spinning and
         `DiffDrive` integrated that spin as if it were real travel. A
         second caster, mirroring the rear one at the equivalent forward
         position, gives the chassis genuine 4-point ground support (2
         driven wheels + 2 passive casters) regardless of how hard it
         accelerates or brakes - the direct structural fix, rather than
         just re-tuning speed/accel numbers down and hoping the margin is
         enough. -->
    <link name="front_caster_wheel">
      <pose>0.13 0 0.03 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000036</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000036</iyy>
          <iyz>0</iyz>
          <izz>0.000036</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.001</mu>
              <mu2>0.001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- Effectively unlimited rotation - a driven wheel, not a hinge.
               Same "very large but finite" convention the installed
               Ignition example vehicles use, since SDF's <limit> is
               mandatory on a revolute joint. -->
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="front_caster_wheel_joint" type="ball">
      <parent>base_link</parent>
      <child>front_caster_wheel</child>
    </joint>

    <joint name="caster_wheel_joint" type="ball">
      <parent>base_link</parent>
      <child>caster_wheel</child>
    </joint>

    <!-- Front-facing, downward-tilted depth/RGB-D camera - a later,
         step05 addition (see docs/work-docs/nav/step05_frontier_tunnel_navigation.md).
         `emap`'s UAV camera looks straight down, so anything that occludes
         the ground from directly overhead (a tunnel/culvert's interior) is
         permanently unobservable to it, no matter how long the area gets
         scanned - a real, structural gap, not a bug. This sensor gives the
         UGV ITSELF a way to observe exactly that kind of terrain as it
         physically approaches it, feeding the SAME shared /elevation_map
         (see emap/elevation_mapping_node.py's secondary_points_topic) so a
         frontier-aware plan through, say, a tunnel can eventually be
         confirmed with real data instead of staying a permanent guess.

         Mounted on its own link (not directly a <sensor> under base_link
         like the lidar above) because it needs its own non-trivial
         orientation - pitch=0.6 rad (~34 degrees down from horizontal) - a
         compromise angle chosen to see ground a meter or two ahead (useful
         for spotting a tunnel mouth before actually entering it) while
         still catching enough near-ground detail once inside a low
         tunnel, rather than either purely forward (sees walls, not the
         floor) or purely down like the UAV's own camera (would only ever
         see what's directly under the chassis, too late to help route
         planning approaching from a distance). Position (0.18, 0, 0.05) is
         low and forward on the chassis - see docs/work-docs/nav/step05_...md
         for why this angle/position combination was chosen and how it was
         verified live to actually see a tunnel's interior floor. -->
    <link name="front_camera_link">
      <pose>0.18 0 0.05 0 0.6 0</pose>
      <visual name="front_camera_visual">
        <geometry>
          <box>
            <size>0.03 0.05 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <!-- No <collision> - a small sensor housing like this contributes
           nothing to the vehicle's own physical footprint, and giving it
           one risks it being the first thing to clip a tunnel's ceiling
           instead of the chassis itself dictating clearance. -->
      <sensor name="front_camera" type="rgbd_camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>nav_ugv/front_camera</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <!-- Shorter far clip than the UAV's own 20m (step09/step11's
                 max_valid_range clamp-artifact fix applies here too, at
                 whatever this sensor's own far clip actually is - see
                 config/elevation_mapping.yaml's secondary-sensor comment) -
                 this is a short-range, close-up sensor by design; a UGV
                 investigating what's a few meters ahead has no use for
                 anything past that, and a shorter range means less data to
                 fuse per frame for the same useful information. -->
            <near>0.1</near>
            <far>8.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>

    <!-- User-requested (2026-09-24): a camera that actually shows the room
         for VIDEO RECORDING only - NOT used for navigation/sensing, unlike
         front_camera_link above. front_camera's 0.6 rad (~34 deg) downward
         tilt at a 0.05m mount height is load-bearing for real elevation-map
         gap-filling inside the tunnel (see tunnel_demo.launch.py's own
         secondary_points_topic comment) and deliberately sees almost
         nothing but close-up floor a few tens of cm ahead - exactly why a
         recording taken from it looks like flat color bands, not a room.
         This sensor is mounted much higher (0.22m, near the chassis roof)
         with only a mild ~8.6 deg tilt, so it can see across the room
         (walls, the tunnel opening, the goal marker) instead. Plain RGB
         `camera` type, not `rgbd_camera` - no depth/point-cloud needed for
         a video feed, and one fewer depth stream to strain CPU (GUI-mode
         resource contention already required point_cloud_stride tuning
         elsewhere - see tunnel_demo.launch.py's mapping_node/voxel_map_node
         comments). -->
    <link name="video_camera_link">
      <pose>0.1 0 0.22 0 0.15 0</pose>
      <!-- Precautionary fix (2026-09-24, second pass): a link with no
           <inertial> element silently defaults to SDFormat's own fallback
           of mass=1.0kg with a UNIT inertia matrix, not massless. Mounted
           at z=0.22 - well above the 1.5kg chassis's own center at
           z=0.125 - an unaccounted phantom 1kg up there would be a real
           center-of-mass/top-heaviness risk on a small, light (~2.1kg
           tracked) robot, the same class of "physical chassis instability"
           this project already had to fix once before (see git history).
           NOTE: two runs that appeared "stuck far from goal" right after
           this link was first added turned out to be a false alarm from
           a DIFFERENT bug - the live monitoring script was reading
           /ugv/odom, which is stale/wrong DiffDrive-sourced odometry for
           this world, not the actual ground truth (/model/nav_ugv/
           odometry) - so this fix's necessity was never actually proven
           against those two runs specifically. It's kept anyway because
           it's cheap, correct, and removes a real (if unproven-impactful)
           risk. front_camera_link (existing, unmodified) has this same
           gap and is deliberately left alone since it's part of the
           already-proven-working baseline. -->
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000005</ixx>
          <iyy>0.000005</iyy>
          <izz>0.000005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="video_camera_visual">
        <geometry>
          <box>
            <size>0.03 0.05 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <!-- Load note (2026-09-24, third pass): the 160x120@5Hz cut made in
           the previous pass was found NOT necessary - that pass's "stuck"
           runs turned out to be a false alarm from reading the wrong
           ground-truth topic (see config/bridge.yaml's ground-truth-
           odometry entry below), not a real load/instability problem.
           Restored to 320x240@10Hz now that this project records in
           headless mode by default for this purpose anyway (no GUI render
           client - see tunnel_demo.launch.py/record_run.py - which is
           where the actual ~284% CPU cost lived), and for clearer,
           less-blurry footage. -->
      <sensor name="video_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>nav_ugv/video_camera</topic>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>15.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="video_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>video_camera_link</child>
    </joint>
  </model>
</sdf>
