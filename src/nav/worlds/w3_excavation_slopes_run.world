<?xml version="1.0"?>
<!-- GENERATED by src/nav/scripts/build_world.py - edit the world definition in
     src/nav/scripts/worldgen/worlds/, not this file. -->
<sdf version="1.6">
  <world name="w3_excavation_slopes">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.8 0.85 0.9</background_color>
        <camera_pose>-60 -60 45 0 0.5 0.8</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
    </gui>

    <!-- Directional light high above (z=500) like our other worlds: a light posed
         inside the sensing volume was once misread as geometry by the software
         depth camera (emap step 11). -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.85 0.85 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -3.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>300.0 300.0</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>300.0 300.0</size></plane></geometry>
          <material><ambient>0.5 0.45 0.34 1</ambient><diffuse>0.5 0.45 0.34 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>

    <include><name>w3_excavation_slopes_terrain</name><uri>model://w3_excavation_slopes_terrain</uri><pose>0 0 0 0 0 0</pose></include>
    <include><name>truck_a</name><uri>model://site_dumper_truck_green</uri><pose>10.0000 -4.0000 0.0000 0 0 0.50000</pose></include>
    <include><name>truck_b</name><uri>model://site_concrete_truck_red</uri><pose>-6.0000 16.0000 0.0000 0 0 -0.90000</pose></include>
    <include><name>truck_c</name><uri>model://site_small_truck</uri><pose>26.0000 0.0000 0.0000 0 0 1.60000</pose></include>
    <include><name>barrel_0</name><uri>model://site_barrel</uri><pose>-2.0000 -14.0000 0.0000 0 0 0.00000</pose></include>
    <include><name>barrel_1</name><uri>model://site_barrel</uri><pose>-0.7000 -13.6000 0.0000 0 0 0.00000</pose></include>
    <include><name>barrel_2</name><uri>model://site_barrel</uri><pose>0.6000 -14.0000 0.0000 0 0 0.00000</pose></include>
    <include><name>barrel_3</name><uri>model://site_barrel</uri><pose>1.9000 -13.6000 0.0000 0 0 0.00000</pose></include>
    <include><name>barrel_4</name><uri>model://site_barrel</uri><pose>3.2000 -14.0000 0.0000 0 0 0.00000</pose></include>
    <include><name>planks_a</name><uri>model://site_planks_yellow</uri><pose>12.0000 26.0000 0.0000 0 0 0.30000</pose></include>
    <include><name>boxes_a</name><uri>model://site_box_stack_brown</uri><pose>-3.0000 -22.0000 0.0000 0 0 0.00000</pose></include>
    
    <include>
      <name>nav_ugv</name>
      <uri>model://nav_ugv</uri>
      <pose>4.000 -6.000 0.000 0 0 0.0000</pose>
      <plugin filename="ignition-gazebo-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>0.49</wheel_separation><!-- effective: a skid-steer robot slips, so DiffDrive must be told a wider track than the real 0.3756 m (measured: turns at the commanded rate; see models/nav_ugv/model.sdf) -->
        <wheel_radius>0.098</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odometry</odom_topic>
        <frame_id>nav_ugv/wheel_odom</frame_id>
        <child_frame_id>nav_ugv/wheel_odom_base</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <plugin filename="ignition-gazebo-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>2</dimensions>
        <odom_frame>nav_ugv/odom</odom_frame>
        <robot_base_frame>nav_ugv/base_link</robot_base_frame>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </include>

    <model name="overhead_overview_camera">
      <static>true</static>
      <pose>0.00 0.00 150.0 0 1.5707963 1.5707963</pose>
      <link name="link">
        <sensor name="room_overview_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>10.0</update_rate>
          <topic>/room_overhead/image</topic>
          <camera>
            <horizontal_fov>0.4076</horizontal_fov>
            <image><width>1440</width><height>1440</height></image>
            <clip><near>0.5</near><far>400</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
