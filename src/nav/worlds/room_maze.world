    <include>
      <name>iris_quad</name>
      <uri>model://iris_quad</uri>
      <!-- REAL BUG FOUND LIVE: this used to spawn at z=3.5 ("well above the
           walls, room to fly and see the maze"). MulticopterVelocityControl
           gives ZERO thrust until something actually commands a velocity
           (see the README's "Controlling the UAV" section) - so for
           however many seconds pass before autonomous_uav's autopilot node
           (or a person) sends the first command, the drone free-falls
           uncontrolled. From 3.5m that's enough energy to bounce on impact
           and land in a genuinely bad pose - confirmed live: one such fall
           left it resting on its SIDE (a ~90 degree roll, not just yaw),
           a configuration `MulticopterVelocityControl`'s attitude
           controller can't recover from at all (its own thrust axis is no
           longer pointing anywhere near "up") - completely stuck
           regardless of any command sent afterward.

           Every other emap world (uav_test.world, bump_test.world,
           construction_site.world) spawns iris_quad right at/near ground
           level (z=0.1) for exactly this reason - already the proven-safe
           pattern this project uses everywhere else, deviated from here by
           mistake. Restored: a fall of a few centimeters from z=0.1 has
           nowhere near enough energy to tip the vehicle over, so there's
           nothing left to "recover" from regardless of how long it takes
           for control to start - autonomous_uav's autopilot node then
           climbs to altitude itself under CONTROLLED flight (which is what
           actually satisfies "start it in the air" safely, rather than an
           uncontrolled mid-air spawn). -->
      <pose>-0.7 -3.0 0.1 0 0 0</pose>

      <!-- Per-rotor thrust/torque model. Constants are the Iris airframe's own
           published values (PX4/PX4-SITL_gazebo-classic models/iris/iris.sdf.jinja),
           reused here so the physics matches the vendored geometry. -->
      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_0_joint</jointName>
        <linkName>rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>0</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_1_joint</jointName>
        <linkName>rotor_1</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>1</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_2_joint</jointName>
        <linkName>rotor_2</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>2</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_3_joint</jointName>
        <linkName>rotor_3</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>3</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>

      <!-- Body-frame linear/angular velocity controller: closes the loop from a
           commanded twist to the four rotors above. -->
      <plugin filename="ignition-gazebo-multicopter-control-system"
        name="gz::sim::systems::MulticopterVelocityControl">
        <robotNamespace>iris_quad</robotNamespace>
        <commandSubTopic>gazebo/command/twist</commandSubTopic>
        <enableSubTopic>enable</enableSubTopic>
        <comLinkName>base_link</comLinkName>
        <velocityGain>2.7 2.7 2.7</velocityGain>
        <attitudeGain>2 3 0.15</attitudeGain>
        <angularRateGain>0.4 0.52 0.18</angularRateGain>
        <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>

        <rotorConfiguration>
          <rotor>
            <jointName>rotor_0_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>rotor_1_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>rotor_2_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>-1</direction>
          </rotor>
          <rotor>
            <jointName>rotor_3_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>-1</direction>
          </rotor>
        </rotorConfiguration>
      </plugin>

      <!-- Explicit frame names (rather than the plugin's defaults) so they match
           the model's own link name (base_link) used everywhere else in this file. -->
      <plugin filename="ignition-gazebo-odometry-publisher-system"
        name="ignition::gazebo::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_frame>iris_quad/odom</odom_frame>
        <robot_base_frame>iris_quad/base_link</robot_base_frame>
      </plugin>
    </include>

    <!-- The UGV - see models/nav_ugv/model.config for why its actuation
         plugin is attached here rather than baked into the model itself
         (same pattern as iris_quad's motor plugins above).

         REAL BUG FOUND LIVE: this was first placed at (-0.7, -3.0) - eyeballed
         from the wall poses as "a corridor junction", but never actually
         verified against a real flown map. It turned out to read
         traversability=LETHAL (close enough to Wall_18/Wall_28's corner
         for a real slope/step-height reading) - meaning nav_ugv could NEVER
         get a valid PRM plan, because planner_node.py always plans FROM the
         UGV's own current position, and a start point inside LETHAL space
         is rejected outright (see prm_planner.py's docstring on this exact
         design choice) - a permanent deadlock: it can't move because no
         plan exists, and no plan exists because it hasn't moved off a
         rejected cell. Confirmed by live-checking `/elevation_map` after a
         real flight: (-0.7, -3.0) genuinely reads walkable=False, while
         (-0.7, -4.5) - 1.5m further into the corridor - reads walkable=True
         with a full ~0.7m clear margin in every direction. Moved here
         instead - MUST match launch/nav_sim.launch.py's
         `ugv_odom_static_tf` translation exactly (both are the single
         source of truth for "where nav_ugv actually spawns"). -->
    <include>
      <name>nav_ugv</name>
      <uri>model://nav_ugv</uri>
      <pose>-0.7 -4.5 0.0 0 0 0</pose>

      <plugin filename="ignition-gazebo-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.4</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odometry</odom_topic>
        <frame_id>nav_ugv/odom</frame_id>
        <child_frame_id>nav_ugv/base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </include>
  </world>
</sdf>
