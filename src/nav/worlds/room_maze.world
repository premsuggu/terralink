<?xml version="1.0" ?>
<!--
  nav step 1: the maze/room test world for the UAV-maps-then-UGV-navigates
  pipeline. Wall geometry ported (not literally copied - see below) from
  src/d3/my_bot/worlds/roomWithObstacles.world's `room_with_walls_10x10`
  model, per the plan to reuse d3's own proven test environment rather than
  build a new one, since this milestone is about replacing d3's pixel-color
  walkability classification, not its geometry.

  What changed from the source file and why:
  - d3's world targets Gazebo CLASSIC (`gazebo_ros`), which this project
    doesn't have installed (see docs/work-docs/emap/IMPLEMENTATION_PLAN.md's
    "Why restart" - the exact same reason `terralink_elevation` was
    abandoned for `emap`). Only the WALL GEOMETRY was ported - the
    surrounding physics/scene/GUI/sensor plugin boilerplate below is
    `emap`'s own already-proven Ignition Fortress template (see
    worlds/bump_test.world in the emap package), not d3's.
  - Wall `<material>` blocks referenced Gazebo Classic's built-in
    `file://media/materials/scripts/gazebo.material` script resource
    (`Gazebo/Grey`), which doesn't resolve under Ignition - replaced with
    plain `<ambient>/<diffuse>/<specular>` color values giving the same
    flat gray look, no external resource needed.
  - The light's pose is 0 0 500 (not the source file's 0 0 10) - the exact,
    already-diagnosed bug from emap's step 11
    (docs/work-docs/emap/step11_far_range_and_flight_safety_fixes.md):
    under this environment's software-rendered Ogre2 depth camera, a light
    posed inside the map's operational volume can occasionally be misread
    as physical geometry. A directional light's illumination depends only
    on <direction>, never <pose>, so moving it costs nothing and avoids
    rediscovering that bug here.
  - d3's own `<state>` snapshot, extra prop models (a table, construction
    cones, cubes) baked into that one save, and its second embedded
    `room_with_walls_10x10` copy inside that state block were all dropped -
    none of those are real, load-bearing world content (see the
    step doc for this milestone for the full explanation); this world is
    deliberately just the wall maze, flat ground, and the UAV, matching the
    plan's "prove the nav pipeline in isolation from terrain complexity".

  The UGV is NOT included here - like d3's own UGV (spawned separately via
  its own launch file, never embedded in the .world file), nav's vendored
  UGV is spawned into this world by launch/nav_sim.launch.py via
  `ros_gz_sim create`, not baked into this SDF.
-->
<sdf version="1.6">
  <world name="room_maze">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- See uav_test.world for why this <gui> block (pinning the 3D view to
         ogre2) needs to be here explicitly rather than left to whatever
         local GUI config this machine happens to have. -->
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-10 -8 10 0 0.5 0.6</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <!-- z=500, not the source file's z=10 - see this file's top docstring. -->
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.33 0.42 0.18 1</ambient>
            <diffuse>0.45 0.55 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

