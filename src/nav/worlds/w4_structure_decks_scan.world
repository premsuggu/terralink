    <model name="walk_roof"><static>true</static><pose>0.0000 -20.0000 3.1600 0 0 0.00000</pose><link name="link"><collision name="c"><geometry><box><size>40.0000 3.4000 0.1200</size></box></geometry></collision><visual name="v"><transparency>0.8</transparency><geometry><box><size>40.0000 3.4000 0.1200</size></box></geometry><material><ambient>0.550 0.500 0.400 1</ambient><diffuse>0.550 0.500 0.400 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
    <include><name>truck_a</name><uri>model://site_small_truck</uri><pose>10.0000 -15.0000 0.0000 0 0 1.57080</pose></include>
    <include><name>barrel_0</name><uri>model://site_barrel</uri><pose>19.0000 -6.0000 0.0000 0 0 0.00000</pose></include>
    <include><name>barrel_1</name><uri>model://site_barrel</uri><pose>19.0000 -4.9000 0.0000 0 0 0.00000</pose></include>
    <include><name>barrel_2</name><uri>model://site_barrel</uri><pose>19.0000 -3.8000 0.0000 0 0 0.00000</pose></include>
    <include><name>barrel_3</name><uri>model://site_barrel</uri><pose>19.0000 -2.7000 0.0000 0 0 0.00000</pose></include>
    <include><name>planks_a</name><uri>model://site_planks_blue</uri><pose>-21.0000 14.0000 0.0000 0 0 0.40000</pose></include>
    <include><name>box_a</name><uri>model://site_box_white</uri><pose>21.5000 14.0000 0.0000 0 0 0.00000</pose></include>
    <include><name>box_b</name><uri>model://site_box_black</uri><pose>21.5000 15.2000 0.0000 0 0 0.00000</pose></include>
    
    <include>
      <name>nav_ugv</name>
      <uri>model://nav_ugv</uri>
      <pose>-21.500 -6.000 0.000 0 0 0.0000</pose>
      <plugin filename="ignition-gazebo-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>0.49</wheel_separation><!-- effective: a skid-steer robot slips, so DiffDrive must be told a wider track than the real 0.3756 m (measured: turns at the commanded rate; see models/nav_ugv/model.sdf) -->
        <wheel_radius>0.098</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odometry</odom_topic>
        <frame_id>nav_ugv/wheel_odom</frame_id>
        <child_frame_id>nav_ugv/wheel_odom_base</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <plugin filename="ignition-gazebo-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>2</dimensions>
        <odom_frame>nav_ugv/odom</odom_frame>
        <robot_base_frame>nav_ugv/base_link</robot_base_frame>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </include>

    <model name="overhead_overview_camera">
      <static>true</static>
      <pose>0.00 0.00 150.0 0 1.5707963 1.5707963</pose>
      <link name="link">
        <sensor name="room_overview_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>1.0</update_rate>
          <topic>/room_overhead/image</topic>
          <camera>
            <horizontal_fov>0.3433</horizontal_fov>
            <image><width>1440</width><height>1440</height></image>
            <clip><near>0.5</near><far>400</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <include>
      <name>iris_quad</name>
      <uri>model://iris_quad</uri>
      <!-- Near-ground spawn (see room_maze.world's own docstring for the
           real free-fall/tip-over bug this convention avoids) - room A
           side, but offset 1.5m in Y from the UGV's own spawn point below.

           REAL BUG FOUND LIVE: an earlier version of this file spawned the
           UAV at the EXACT same (x, y) as the UGV (both at (-3.0, 0.0)) -
           the two robots' collision geometry physically overlapped at
           spawn, and the resulting contact impulse tipped the UAV over
           (confirmed live: its odometry orientation quaternion read
           roughly (x=0.97, y=-0.18, z=0.16, w=0.02) - a huge roll, not a
           level hover - while `/cmd_vel` kept commanding a normal climb
           the whole time; a rolled-over multirotor's thrust axis no longer
           points anywhere near "up", so no amount of correct control logic
           could recover it, same class of bug as room_maze.world's own
           z=3.5-spawn free-fall issue, just triggered by a different root
           cause). Fixed by simply not spawning two robots on top of each
           other - 1.5m of clearance in Y is comfortably more than either
           robot's own footprint. -->
      <pose>-21.50 -4.50 0.1 0 0 0</pose>

      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_0_joint</jointName>
        <linkName>rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>0</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_1_joint</jointName>
        <linkName>rotor_1</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>1</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_2_joint</jointName>
        <linkName>rotor_2</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>2</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_3_joint</jointName>
        <linkName>rotor_3</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>3</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>

      <plugin filename="ignition-gazebo-multicopter-control-system"
        name="gz::sim::systems::MulticopterVelocityControl">
        <robotNamespace>iris_quad</robotNamespace>
        <commandSubTopic>gazebo/command/twist</commandSubTopic>
        <enableSubTopic>enable</enableSubTopic>
        <comLinkName>base_link</comLinkName>
        <velocityGain>2.7 2.7 2.7</velocityGain>
        <attitudeGain>2 3 0.15</attitudeGain>
        <angularRateGain>0.4 0.52 0.18</angularRateGain>
        <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>
        <rotorConfiguration>
          <rotor>
            <jointName>rotor_0_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>rotor_1_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>rotor_2_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>-1</direction>
          </rotor>
          <rotor>
            <jointName>rotor_3_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>-1</direction>
          </rotor>
        </rotorConfiguration>
      </plugin>

      <plugin filename="ignition-gazebo-odometry-publisher-system"
        name="ignition::gazebo::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_frame>iris_quad/odom</odom_frame>
        <robot_base_frame>iris_quad/base_link</robot_base_frame>
      </plugin>
    </include>

  </world>
</sdf>
