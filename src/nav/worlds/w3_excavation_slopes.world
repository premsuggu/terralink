          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
    </gui>

    <!-- Directional light high above (z=500) like our other worlds: a light posed
         inside the sensing volume was once misread as geometry by the software
         depth camera (emap step 11). -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.85 0.85 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -3.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>300.0 300.0</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>300.0 300.0</size></plane></geometry>
          <material><ambient>0.5 0.45 0.34 1</ambient><diffuse>0.5 0.45 0.34 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>

    <include><name>w3_excavation_slopes_terrain</name><uri>model://w3_excavation_slopes_terrain</uri><pose>0 0 0 0 0 0</pose></include>
    <include><name>truck_a</name><uri>model://site_dumper_truck_green</uri><pose>10.0000 -4.0000 0.0000 0 0 0.50000</pose></include>
