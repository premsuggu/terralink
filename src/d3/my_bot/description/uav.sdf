<?xml version='1.0'?>
<sdf version='1.7'>
  <model name='my_uav'>
    <static>1</static>
    <link name='base_link'>
      <inertial>
        <pose>0 0 0.005 0 -0 0</pose>
        <mass>50</mass>
        <inertia>
          <ixx>0.375417</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.375417</iyy>
          <iyz>0</iyz>
          <izz>0.75</izz>
        </inertia>
      </inertial>
      <sensor name='camera_uav' type='camera'>
        <always_on>1</always_on>
        <visualize>0</visualize>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.25</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1000</width>
            <height>1000</height>
          </image>
          <clip>
            <near>1</near>
            <far>15</far>
          </clip>
        </camera>
        <plugin name='uav_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>/my_uav</namespace>
            <remapping>~/image_raw:=/camera_uav/image_raw</remapping>
          </ros>
          <frame_name>camera_link_optical_uav</frame_name>
        </plugin>
        <pose>0 0 10 3.14159 1.57079 3.14159</pose>
      </sensor>
      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
      <pose>0 0 0 0 -0 0</pose>
      <visual name='base_link_fixed_joint_lump__chassis_visual'>
        <pose>0 0 0.005 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.01 0.01</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/White</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
          <shader type='pixel'/>
          <emissive>0 0 0 1</emissive>
        </material>
        <transparency>0</transparency>
        <cast_shadows>1</cast_shadows>
      </visual>
      <visual name='base_link_fixed_joint_lump__camera_link_uav_visual_1'>
        <pose>0 0 10 3.14159 1.57079 3.14159</pose>
        <geometry>
          <box>
            <size>0.05 0.03 0.03</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Red</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
          <shader type='pixel'/>
          <emissive>0 0 0 1</emissive>
        </material>
        <transparency>0</transparency>
        <cast_shadows>1</cast_shadows>
      </visual>
      <collision name='base_link_fixed_joint_lump__chassis_collision'>
        <laser_retro>0</laser_retro>
        <max_contacts>10</max_contacts>
        <pose>0 0 0.005 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.1 0.01</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
            <torsional>
              <coefficient>1</coefficient>
              <patch_radius>0</patch_radius>
              <surface_radius>0</surface_radius>
              <use_patch_radius>1</use_patch_radius>
              <ode>
                <slip>0</slip>
              </ode>
            </torsional>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>1e+06</threshold>
          </bounce>
          <contact>
            <collide_without_contact>0</collide_without_contact>
            <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
            <collide_bitmask>1</collide_bitmask>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0</min_depth>
            </ode>
            <bullet>
              <split_impulse>1</split_impulse>
              <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
            </bullet>
          </contact>
        </surface>
      </collision>
    </link>
    <allow_auto_disable>1</allow_auto_disable>
  </model>
</sdf>
