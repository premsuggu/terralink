<?xml version="1.0" ?>
<!--
  emap step 12: a hand-composed construction-site scene - a real target
  environment for this project (TerraLink's own stated domain is
  "construction sites, disaster response"), not just an isolated terrain
  feature like bump_test.world's single Gaussian bump.

  Terrain: generated by scripts/generate_construction_heightmap.py - mostly
  flat ground with one excavated pit (foundation dig) and one spoil mound
  (the dirt piled up from digging it) over a 30m field.

  Everything else is vendored from Gazebo Fuel (all individually license-
  checked - see docs/work-docs/emap/step12_construction_site_world.md for
  the full provenance table) except building_frame, which is self-authored
  (no good open "building under construction" mesh exists, and our 2.5D map
  can't represent a finished building's overhangs any differently from a
  plain box anyway - see that model's own model.config for the reasoning).

  Fly over the site and read /elevation_map back - see step12's docs for
  what to expect at each feature's known coordinates.
-->
<sdf version="1.6">
  <world name="construction_site">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Same <gui> render-engine pinning as uav_test.world/bump_test.world -
         see either for why this needs to be explicit on this machine. -->
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-15 0 12 0 0.5 0</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <!-- pose z=500, not 10 - see step11's fix in bump_test.world/
           uav_test.world for the real bug this avoids: a light posed
           inside the map's operational volume was occasionally misread as
           physical geometry by this environment's software-rendered depth
           camera. A directional light's illumination depends only on
           <direction>, never <pose>, so this changes nothing about how the
           scene looks. -->
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Terrain: flat ground with one excavation pit and one spoil mound -
         see scripts/generate_construction_heightmap.py for the exact
         coordinates/dimensions. NO pose offset on this link - a real bug
         was found live where Ignition's <heightmap> geometry ignores a
         non-zero link pose entirely (confirmed via Gazebo's own physics
         debug log and the depth camera measuring the wrong pit depth) -
         so the terrain is placed at the SDF default identity pose, exactly
         like bump_test.world's bump_terrain, and "flat ground" simply
         lives at absolute world z=1.5 (=PIT_DEPTH_M) instead of z=0 - every
         other model below is placed at that same +1.5 baseline. Collision
         AND visual reference the SAME heightmap image, same reasoning as
         bump_test.world's bump_terrain - a mismatch there would silently
         make every verification meaningless. -->
    <model name="construction_terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>model://heightmaps/construction_terrain.png</uri>
              <size>30 30 3.5</size>
            </heightmap>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <heightmap>
              <uri>model://heightmaps/construction_terrain.png</uri>
              <size>30 30 3.5</size>
              <texture>
                <size>10</size>
                <diffuse>model://heightmaps/diffuse.png</diffuse>
                <normal>model://heightmaps/flat_normal.png</normal>
              </texture>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- The building under construction, anchored just south of the pit
         (its foundation dig) - see models/building_frame/model.config. -->
    <include>
      <name>building_frame</name>
      <uri>model://building_frame</uri>
      <pose>-4 -5 1.5 0 0 0</pose>
    </include>

    <!-- Crane and excavator, both near the pit/building they're servicing. -->
    <include>
      <name>tower_crane</name>
      <uri>model://tower_crane</uri>
      <pose>2 3 1.5 0 0 0</pose>
    </include>
    <include>
      <name>mini_excavator</name>
      <uri>model://mini_excavator</uri>
      <pose>0 5 1.5 0 0 -0.6</pose>
    </include>

    <!-- People: standing/walking figures near the equipment. -->
    <include>
      <name>worker_1</name>
      <uri>model://person_walking</uri>
      <pose>2 5.5 1.5 0 0 2.0</pose>
    </include>
    <include>
      <name>worker_2</name>
      <uri>model://person_walking</uri>
      <pose>-6 -1 1.5 0 0 -1.0</pose>
    </include>
    <include>
      <name>worker_3</name>
      <uri>model://person_standing</uri>
      <pose>3 0 1.5 0 0 3.1</pose>
    </include>

    <!-- Cones marking the excavation's perimeter, barrels staged as
         material near the crane. -->
    <include>
      <name>cone_1</name>
      <uri>model://construction_cone</uri>
      <pose>-7 -0.5 1.5 0 0 0</pose>
    </include>
    <include>
      <name>cone_2</name>
      <uri>model://construction_cone</uri>
      <pose>-1 -0.5 1.5 0 0 0</pose>
    </include>
    <include>
      <name>cone_3</name>
      <uri>model://construction_cone</uri>
      <pose>-4 4.5 1.5 0 0 0</pose>
    </include>
    <include>
      <name>barrel_1</name>
      <uri>model://construction_barrel</uri>
      <pose>3 4 1.5 0 0 0</pose>
    </include>
    <include>
      <name>barrel_2</name>
      <uri>model://construction_barrel</uri>
      <pose>4 1 1.5 0 0 0</pose>
    </include>

    <include>
      <name>iris_quad</name>
      <uri>model://iris_quad</uri>
      <pose>0 0 1.6 0 0 0</pose>

      <!-- Per-rotor thrust/torque model - identical to bump_test.world's,
           see that file's comments for the source of these constants. -->
      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_0_joint</jointName>
        <linkName>rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>0</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_1_joint</jointName>
        <linkName>rotor_1</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>1</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_2_joint</jointName>
        <linkName>rotor_2</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>2</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="ignition-gazebo-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>iris_quad</robotNamespace>
        <jointName>rotor_3_joint</jointName>
        <linkName>rotor_3</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1100</maxRotVelocity>
        <motorConstant>5.84e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>3</motorNumber>
        <rotorDragCoefficient>0.000175</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>

      <plugin filename="ignition-gazebo-multicopter-control-system"
        name="gz::sim::systems::MulticopterVelocityControl">
        <robotNamespace>iris_quad</robotNamespace>
        <commandSubTopic>gazebo/command/twist</commandSubTopic>
        <enableSubTopic>enable</enableSubTopic>
        <comLinkName>base_link</comLinkName>
        <velocityGain>2.7 2.7 2.7</velocityGain>
        <attitudeGain>2 3 0.15</attitudeGain>
        <angularRateGain>0.4 0.52 0.18</angularRateGain>
        <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>

        <rotorConfiguration>
          <rotor>
            <jointName>rotor_0_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>rotor_1_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>rotor_2_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>-1</direction>
          </rotor>
          <rotor>
            <jointName>rotor_3_joint</jointName>
            <forceConstant>5.84e-06</forceConstant>
            <momentConstant>0.06</momentConstant>
            <direction>-1</direction>
          </rotor>
        </rotorConfiguration>
      </plugin>

      <plugin filename="ignition-gazebo-odometry-publisher-system"
        name="ignition::gazebo::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_frame>iris_quad/odom</odom_frame>
        <robot_base_frame>iris_quad/base_link</robot_base_frame>
      </plugin>
    </include>
  </world>
</sdf>
