<?xml version="1.0"?>
<model>
  <name>Building Frame (emap, under construction)</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>TerraLink emap</name>
    <email>software.guild@smail.iitm.ac.in</email>
  </author>

  <description>
    Self-authored (not vendored): a skeletal multi-story concrete/steel frame -
    6 vertical columns + 3 floor slabs, no walls or roof - representing a
    building still under construction. Built entirely from SDF primitive boxes,
    no external meshes, so there is no licensing question about it at all. See
    docs/work-docs/emap/step12_construction_site_world.md for why a hand-built
    frame was chosen over searching for an open-source "building under
    construction" mesh.
  </description>
</model>
