<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="Construction Cone">
    <!-- static=true added for emap: we want cones planted exactly where
         placed (needed for numeric elevation-map verification), not
         subject to physics/gravity settling. -->
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh>
            <scale>10 10 10</scale>
            <uri>model://construction_cone/meshes/construction_cone.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <scale>10 10 10</scale>
            <uri>model://construction_cone/meshes/construction_cone.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
