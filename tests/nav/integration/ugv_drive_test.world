<?xml version="1.0"?>
<sdf version="1.6">
  <world name="ugv_test">
    <physics name="4ms" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.8 0.85 0.9 1</background></scene>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.5 0.3 -1</direction></light>
    <model name="ground"><static>true</static><link name="l">
      <collision name="c"><geometry><box><size>60 60 0.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>60 60 0.2</size></box></geometry><material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.5 0.47 0.42 1</diffuse></material></visual>
      <pose>0 0 -0.1 0 0 0</pose></link></model>
    <model name="wall"><static>true</static><pose>8 0 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 6 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 6 1</size></box></geometry></visual></link></model>
    <model name="curb"><static>true</static><pose>4 3 0.025 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.3 2 0.05</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 2 0.05</size></box></geometry></visual></link></model>
    <include><name>nav_ugv</name><uri>model://nav_ugv</uri><pose>0 0 0 0 0 0</pose>
      <plugin filename="ignition-gazebo-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint><right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>0.49</wheel_separation><wheel_radius>0.098</wheel_radius>
        <topic>cmd_vel</topic><odom_topic>odometry</odom_topic>
        <frame_id>nav_ugv/wheel_odom</frame_id><child_frame_id>nav_ugv/wheel_odom_base</child_frame_id>
      </plugin>
      <plugin filename="ignition-gazebo-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>2</dimensions><odom_frame>nav_ugv/odom</odom_frame><robot_base_frame>nav_ugv/base_link</robot_base_frame><odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </include>
    <model name="chase"><static>true</static><pose>2.2 -2.6 1.3 0 0.4 1.95</pose><link name="l">
      <sensor name="cam" type="camera"><always_on>true</always_on><update_rate>5</update_rate><topic>/chase/image</topic>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>960</width><height>540</height></image><clip><near>0.1</near><far>60</far></clip></camera></sensor></link></model>
  </world>
</sdf>
